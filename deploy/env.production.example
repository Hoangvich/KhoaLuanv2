# Mẫu cấu hình tĩnh khi triển khai thật trên VPS. setup_vps.sh sẽ tạo backend/.env từ file này
# và tự sinh JWT_SECRET. Sau khi tạo xong, KHÔNG commit backend/.env.

DATABASE_URL=postgresql+psycopg://ids_app:ids_app_dev@localhost:5432/ids

# setup_vps.sh thay bằng chuỗi ngẫu nhiên. Nếu tự điền: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=THAY-BANG-CHUOI-NGAU-NHIEN
JWT_EXPIRE_MINUTES=720

# RF được chốt ở kịch bản C, τ* = 0,48 (xem Test_Kich_Ban_C/results/Bao_Cao_Kich_Ban_C.md)
MODEL_PATH=../Model Train/RF/models/rf_F_NOOS.joblib
DEFAULT_TAU=0.48
FLAG_MODE=auto
SENSOR_TIMEZONE=Asia/Ho_Chi_Minh

INCOMING_DIR=data/incoming
PIPELINE_INTERVAL=5
FLOW_RETENTION_DAYS=7

# Tài khoản admin đầu tiên. ĐỔI mật khẩu này trước khi chạy app.seed, rồi đổi tiếp trong Hồ sơ.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay-ngay

# Nginx phục vụ dashboard cùng origin và chuyển tiếp /api, nên trình duyệt gọi cùng gốc.
# Để nguyên dòng dưới là đủ cho truy cập qua IP; nếu có tên miền thì thêm vào, cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://103.65.234.246
