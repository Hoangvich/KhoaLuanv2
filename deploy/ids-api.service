[Unit]
Description=IDS AAHKL - API FastAPI (dashboard)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ids
Group=ids
WorkingDirectory=/opt/aahkl/backend
Environment=PYTHONUTF8=1
ExecStart=/opt/aahkl/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
