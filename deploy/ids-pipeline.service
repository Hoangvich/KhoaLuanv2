[Unit]
Description=IDS AAHKL - Pipeline xu ly theo lo 5 giay
After=network.target postgresql.service ids-api.service
Wants=postgresql.service

[Service]
Type=simple
User=ids
Group=ids
WorkingDirectory=/opt/aahkl/backend
Environment=PYTHONUTF8=1
ExecStart=/opt/aahkl/backend/.venv/bin/python -m pipeline.run
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
